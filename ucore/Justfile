set dotenv-load

CI_BUILD_TAG := env("CI_BUILD_TAG", "")
export AKMODS_REGISTRY := env("AKMODS_REGISTRY", "ghcr.io/ublue-os")
export UCORE_STREAM := env("UCORE_STREAM", "stable")
export FEDORA_VERSION := env("FEDORA_VERSION", "")
export IMAGE_REGISTRY := env("IMAGE_REGISTRY", "ghcr.io/ublue-os")
# lts uses stable CoreOS base with longterm kernel; stable and testing use stock coreos kernel
COREOS_STREAM := if UCORE_STREAM == 'lts' { 'stable' } else { UCORE_STREAM }
export KERNEL_FLAVOR := env("KERNEL_FLAVOR", if UCORE_STREAM == 'lts' { "longterm-6.18" } else { 'coreos-' + COREOS_STREAM })
export KERNEL_VERSION := env("KERNEL_VERSION", "")
export NVIDIA_TAG := env("NVIDIA_TAG", "")
SYFT_CMD := env("SYFT_CMD", "syft")
export TARGET_IMAGE := env("TARGET_IMAGE", "ucore-minimal")
GIT_ROOT := env("GIT_ROOT", "$(git rev-parse --show-toplevel)")
SUDO_IF := shell('if [ $(id -u) -ne 0 ]; then echo sudo; fi')
ROOTFUL_PODMAN := env("ROOTFUL_PODMAN", SUDO_IF + " podman")
DESCRIPTION := env("DESCRIPTION", "")

_default:
    @just --list --unsorted

# Local VM test: boot an FCOS QEMU image, switch to non-direct-stream SOURCEs,
# then TARGET, and reboot twice. Prereqs: KVM, podman, jq, curl, xz, qemu, OVMF.
# Caches the FCOS qemu image under the user's cache directory.
vm-test source_image target_image:
    #!/usr/bin/env bash
    set -euo pipefail
    exec bash ./vm-test.sh "{{ source_image }}" "{{ target_image }}"

# Direct local image test: installs IMAGE to a temporary FCOS-compatible disk
# through bcvk, then validates two boots. This is not the recommended FCOS
# install/switch workflow. Prereqs: vm-test prereqs plus bcvk and virtiofsd.
vm-test-direct image:
    #!/usr/bin/env bash
    set -euo pipefail
    exec bash ./vm-test.sh --direct "{{ image }}"

check:
    just --fmt --check
    python3 -m unittest discover -s ../.github/tests -v

upstream-version image:
    #!/usr/bin/env bash
    set -euo pipefail

    image='{{ image }}'
    version=$(skopeo inspect "docker://${image}:{{ COREOS_STREAM }}" | \
            jq -r '.["Labels"]["org.opencontainers.image.version"]')
    if [ -z "$version" ] || [ "null" = "$version" ]; then
      echo "inspected image ($image) version must not be empty or null" >&2
      exit 1
    fi
    printf '%s\n' "$version"

upstream-image:
    #!/usr/bin/env bash
    set -euo pipefail

    image='quay.io/fedora/fedora-coreos'
    version=$(just upstream-version "$image")
    printf '%s:%s\n' "$image" "$version"

# If a stream release is known-bad, pin `image` in this recipe after
# upstream-version and before the fedora/akmods inspect. Do not edit
# upstream-version. Example (F42 pattern from pre-#415):
#   if [[ "${image}" == "44.YYYYMMDD.N.N" ]]; then
#     echo "WARNING: overriding known-bad CoreOS ${image} -> 44.GOOD.N.N (#NNNN)" >&2
#     image="44.GOOD.N.N"
#   fi
# The pin holds nightlies and PRs. Remove it once a good upstream exists.
# Emergency CoreOS pin: https://github.com/ublue-os/ucore/issues/413
stream-info output='stream-info.env':
    #!/usr/bin/env bash
    set -euo pipefail

    output='{{ output }}'
    image=$(just upstream-version quay.io/fedora/fedora-coreos)
    fedora=${image%%.*}
    if [ -z "$fedora" ] || [ "null" = "$fedora" ]; then
        echo "Fedora version must not be empty or null" >&2
        exit 1
    fi

    kernel=$(skopeo inspect \
        "docker://{{ AKMODS_REGISTRY }}/akmods-zfs:{{ KERNEL_FLAVOR }}-${fedora}" | \
        jq -r '.["Labels"]["ostree.linux"]')
    if [ -z "$kernel" ] || [ "null" = "$kernel" ]; then
        echo "inspected linux kernel version must not be empty or null" >&2
        exit 1
    fi

    {
        printf 'COREOS_STREAM=%s\n' '{{ COREOS_STREAM }}'
        printf 'KERNEL_FLAVOR=%s\n' '{{ KERNEL_FLAVOR }}'
        printf 'FEDORA_VERSION=%s\n' "$fedora"
        printf 'IMAGE_VERSION=%s\n' "$image"
        printf 'KERNEL_VERSION=%s\n' "$kernel"
    } > "$output"
    cat "$output"

containerfile upstream_image='':
    #!/usr/bin/env bash
    set -euo pipefail
    set -x

    UPSTREAM_IMAGE='{{ upstream_image }}'
    if [ -z "$UPSTREAM_IMAGE" ]; then
        UPSTREAM_IMAGE="$(just upstream-image)"
    fi

    # Match the akmods release to the selected CoreOS base.
    image_version="${UPSTREAM_IMAGE##*:}"
    if [[ "$image_version" =~ ^([0-9]+)\. ]]; then
        fedora="${BASH_REMATCH[1]}"
        if [ -n "{{ FEDORA_VERSION }}" ] && [ "{{ FEDORA_VERSION }}" != "$fedora" ]; then
            echo "FEDORA_VERSION ({{ FEDORA_VERSION }}) does not match CoreOS image ($UPSTREAM_IMAGE)" >&2
            exit 1
        fi
    elif [ -n "{{ FEDORA_VERSION }}" ]; then
        fedora="{{ FEDORA_VERSION }}"
    else
        echo "Cannot determine Fedora version from CoreOS image: $UPSTREAM_IMAGE" >&2
        exit 1
    fi

    KERNEL_VERSION=""
    if [ -n "{{ KERNEL_VERSION }}" ]; then
        KERNEL_VERSION="-{{ KERNEL_VERSION }}"
    fi
    declare -a CPP_FLAGS
    CPP_FLAGS+=(
      "-DAKMODS_TAG={{ KERNEL_FLAVOR }}-${fedora}${KERNEL_VERSION}"
      "-DAKMODS_REGISTRY={{ AKMODS_REGISTRY }}"
      "-DUCORE={{ UCORE_STREAM }}"
      "-DKERNEL={{ KERNEL_FLAVOR }}"
      "-DUPSTREAM_IMAGE=${UPSTREAM_IMAGE}"
    )
    if [ -n "$NVIDIA_TAG" ]; then
      CPP_FLAGS+=(
        "-DNVIDIA=${NVIDIA_TAG#-}"
      )
    fi

    # direct cpp joins lines and does not work as expected
    cpp -E -P "${CPP_FLAGS[@]}" Containerfile.in -o Containerfile
    cat Containerfile

# Sandbox end-to-end publication testing: https://github.com/ublue-os/ucore/issues/414
build upstream_image='':
    #!/usr/bin/env bash
    set -euo pipefail
    set -x

    just containerfile "{{ upstream_image }}"
    # TODO: use LABELS_FILE to include labels in image
    BUILD_TAG='{{ CI_BUILD_TAG }}'
    if [ -z "$BUILD_TAG" ]; then
        BUILD_TAG='{{ UCORE_STREAM }}{{ NVIDIA_TAG }}'
    fi
    podman build -f Containerfile \
        --target "{{ TARGET_IMAGE }}" \
        -t "{{ TARGET_IMAGE }}:${BUILD_TAG}" .

ci-prepare-build upstream_image='' arch='':
    #!/usr/bin/env bash
    set -euo pipefail
    set -x

    UPSTREAM_IMAGE='{{ upstream_image }}'
    ARCH='{{ arch }}'
    if [ -z "$UPSTREAM_IMAGE" ]; then
        UPSTREAM_IMAGE="$(just upstream-image)"
    fi
    if [ -z "$ARCH" ]; then
        ARCH="$(uname -m)"
    fi

    if [ -z "{{ FEDORA_VERSION }}" ] || [ "null" = "{{ FEDORA_VERSION }}" ]; then
        echo "FEDORA_VERSION must not be empty or null" >&2
        exit 1
    fi
    if [ -z "$UPSTREAM_IMAGE" ] || [ "null" = "$UPSTREAM_IMAGE" ]; then
        echo "upstream image must not be empty or null" >&2
        exit 1
    fi
    if [ -z "{{ KERNEL_VERSION }}" ] || [ "null" = "{{ KERNEL_VERSION }}" ]; then
        echo "KERNEL_VERSION must not be empty or null" >&2
        exit 1
    fi

    if [ "{{ TARGET_IMAGE }}" != "ucore-minimal" ]; then
        just verify-checksum "" "{{ FEDORA_VERSION }}" "$ARCH"
    fi

    AKMODS_ZFS="{{ AKMODS_REGISTRY }}/akmods-zfs:{{ KERNEL_FLAVOR }}-{{ FEDORA_VERSION }}-{{ KERNEL_VERSION }}"
    podman pull "$UPSTREAM_IMAGE"
    podman pull "$AKMODS_ZFS"
    if [ -n "{{ NVIDIA_TAG }}" ]; then
        AKMODS_NVIDIA="{{ AKMODS_REGISTRY }}/akmods{{ NVIDIA_TAG }}:{{ KERNEL_FLAVOR }}-{{ FEDORA_VERSION }}-{{ KERNEL_VERSION }}"
        podman pull "$AKMODS_NVIDIA"
    fi

    kernel=$(podman inspect "$AKMODS_ZFS" | jq -r '.[]["Config"]["Labels"]["ostree.linux"]')
    if [[ "{{ KERNEL_VERSION }}" != "$kernel"*  ]]; then
        echo "pulled akmods-zfs image kernel ($kernel) does not match expected kernel ({{ KERNEL_VERSION }})" >&2
        exit 1
    fi

    if [ -n "{{ NVIDIA_TAG }}" ]; then
        kernel=$(podman inspect "$AKMODS_NVIDIA" | jq -r '.[]["Config"]["Labels"]["ostree.linux"]')
        if [[ "{{ KERNEL_VERSION }}" != "$kernel"*  ]]; then
            echo "pulled akmods{{ NVIDIA_TAG }} image kernel ($kernel) does not match expected kernel ({{ KERNEL_VERSION }})" >&2
            exit 1
        fi
    fi

    just containerfile "$UPSTREAM_IMAGE"

# Download and checksum-verify a pinned CI dependency. Prints the verified file path.
ci-dep name:
    @./github-pkgs.sh download "{{ name }}" --manifest ./ci-deps.json --release "" --arch ""

# Verify one package, or all effective entries, download successfully and match the manifest checksum.
verify-checksum package='' release='{{ FEDORA_VERSION }}' arch='':
    #!/usr/bin/env bash
    set -euo pipefail

    package='{{ package }}'
    release='{{ release }}'
    arch='{{ arch }}'
    failed=0

    if [ -z "$release" ]; then
        version=$(just upstream-version quay.io/fedora/fedora-coreos)
        release=${version%%.*}
    fi

    if [ -z "$arch" ]; then
        arch="$(uname -m)"
    fi

    if [ -n "$package" ]; then
        ./github-pkgs.sh verify-checksum "$package" --release "$release" --arch "$arch"
    else
        mapfile -t entries < <(./github-pkgs.sh list --release "$release" --arch "$arch")
        for entry in "${entries[@]}"; do
            name=$(jq -r '.name' <<<"$entry")
            release_arg=$(jq -r '.release // empty' <<<"$entry")

            if [ -z "$release_arg" ]; then
                release_arg="$release"
            fi

            printf 'Verifying %s for release=%s arch=%s\n' "$name" "$release_arg" "$arch"
            if ! ./github-pkgs.sh verify-checksum "$name" --release "$release_arg" --arch "$arch"; then
                failed=1
            fi
        done

        if [ "$failed" -ne 0 ]; then
            printf 'One or more package entries failed checksum verification\n' >&2
            exit 1
        fi
    fi

package-provenance image='' output='':
    #!/usr/bin/env bash
    set -euo pipefail

    IMAGE='{{ image }}'
    BUILD_TAG='{{ CI_BUILD_TAG }}'
    if [ -z "$IMAGE" ]; then
        if [ -z "$BUILD_TAG" ]; then
            BUILD_TAG='{{ UCORE_STREAM }}{{ NVIDIA_TAG }}'
        fi
        IMAGE='{{ TARGET_IMAGE }}:'"$BUILD_TAG"
    fi

    OUTPUT='{{ output }}'
    if [ -z "$OUTPUT" ]; then
        NVIDIA_SEGMENT='{{ NVIDIA_TAG }}'
        if [ -n "$NVIDIA_SEGMENT" ]; then
            NVIDIA_SEGMENT="-${NVIDIA_SEGMENT#-}"
        fi
        OUTPUT="audit/{{ TARGET_IMAGE }}-{{ UCORE_STREAM }}${NVIDIA_SEGMENT}-package-provenance.txt"
    fi

    if ! podman image exists "$IMAGE"; then
        printf 'Local image not found: %s\n' "$IMAGE" >&2
        printf 'Build it first with the matching environment, for example:\n' >&2
        printf '  TARGET_IMAGE=%s UCORE_STREAM=%s NVIDIA_TAG=%s just build\n' \
            '{{ TARGET_IMAGE }}' '{{ UCORE_STREAM }}' '{{ NVIDIA_TAG }}' >&2
        exit 1
    fi

    mkdir -p "$(dirname "$OUTPUT")"
    podman run --rm --entrypoint /usr/bin/bash "$IMAGE" -lc \
        "dnf repoquery --installed --qf '%{name}|%{evr}|%{arch}|%{from_repo}\n' | sort" \
        > "$OUTPUT"

    printf 'Wrote package provenance to %s\n' "$OUTPUT"
    printf 'Repo counts:\n'
    cut -d '|' -f4 "$OUTPUT" | sort | uniq -c | sort -nr

    printf '\nNon-Fedora packages...\n'
    for NON_FED_REPO in $(cat "$OUTPUT" | rev | cut -f1 -d\| | rev |sort -u | grep -v -E "^fedora$|^updates$|^updates-archive$|^<unknown>$");
    do
        printf "\n$NON_FED_REPO packages:\n"
        grep "$NON_FED_REPO$" "$OUTPUT"
    done

gen-sbom image='' output='':
    #!/usr/bin/env bash
    set -euo pipefail

    IMAGE='{{ image }}'
    BUILD_TAG='{{ CI_BUILD_TAG }}'
    if [ -z "$IMAGE" ]; then
        if [ -z "$BUILD_TAG" ]; then
            BUILD_TAG='{{ UCORE_STREAM }}{{ NVIDIA_TAG }}'
        fi
        IMAGE='{{ TARGET_IMAGE }}:'"$BUILD_TAG"
    fi

    OUTPUT='{{ output }}'
    if [ -z "$OUTPUT" ]; then
        NVIDIA_SEGMENT='{{ NVIDIA_TAG }}'
        if [ -n "$NVIDIA_SEGMENT" ]; then
            NVIDIA_SEGMENT="-${NVIDIA_SEGMENT#-}"
        fi
        OUTPUT="audit/{{ TARGET_IMAGE }}-{{ UCORE_STREAM }}${NVIDIA_SEGMENT}-sbom.spdx.json"
    fi

    if ! podman image exists "$IMAGE"; then
        if podman image exists "localhost/$IMAGE"; then
            IMAGE="localhost/$IMAGE"
        else
            printf 'Local image not found: %s\n' "$IMAGE" >&2
            printf 'Build it first with the matching environment, for example:\n' >&2
            printf '  TARGET_IMAGE=%s UCORE_STREAM=%s NVIDIA_TAG=%s just build\n' \
                '{{ TARGET_IMAGE }}' '{{ UCORE_STREAM }}' '{{ NVIDIA_TAG }}' >&2
            exit 1
        fi
    fi

    WORK_DIR="$(mktemp -d)"
    ROOTFS="${WORK_DIR}/rootfs"
    CONTAINER="gen-sbom-${RANDOM}-${RANDOM}"
    cleanup() {
        status=$?
        podman container rm -f "$CONTAINER" >/dev/null 2>&1 || true
        # Exported directories may be read-only. Change permissions only after scanning.
        if ! { find "$WORK_DIR" -type d -exec chmod u+rwx {} \; && rm -rf "$WORK_DIR"; }; then
            printf 'Failed to clean up SBOM temporary directory: %s\n' "$WORK_DIR" >&2
            if [ "$status" -eq 0 ]; then
                status=1
            fi
        fi
        exit "$status"
    }
    trap cleanup EXIT

    mkdir -p "$ROOTFS" "$(dirname "$OUTPUT")"
    podman container create --name "$CONTAINER" "$IMAGE" >/dev/null
    podman export "$CONTAINER" | tar --no-same-owner -C "$ROOTFS" -xf -

    export SYFT_PARALLELISM="${SYFT_PARALLELISM:-$(($(nproc) * 2))}"
    "{{ SYFT_CMD }}" --source-name "$IMAGE" "$ROOTFS" -o "spdx-json=$OUTPUT"
    du -sh "$OUTPUT"

changelog stream='{{ UCORE_STREAM }}' output='' env_output='' notes_file='' max_dated_tags='20' current_artifacts_dir='' release_date='':
    #!/usr/bin/env bash
    set -euo pipefail

    STREAM='{{ stream }}'
    OUTPUT='{{ output }}'
    ENV_OUTPUT='{{ env_output }}'
    NOTES_FILE='{{ notes_file }}'
    MAX_DATED_TAGS='{{ max_dated_tags }}'
    CURRENT_ARTIFACTS_DIR='{{ current_artifacts_dir }}'
    RELEASE_DATE='{{ release_date }}'

    if [ -z "$OUTPUT" ]; then
        OUTPUT="../audit/ucore-${STREAM}-changelog.md"
    fi
    if [ -z "$ENV_OUTPUT" ]; then
        ENV_OUTPUT="../audit/ucore-${STREAM}-changelog.env"
    fi

    declare -a CMD
    CMD=(
        python3
        ../.github/changelogs.py
        --stream "$STREAM"
        --output "$OUTPUT"
        --env-output "$ENV_OUTPUT"
        --image-registry "{{ IMAGE_REGISTRY }}"
        --max-dated-tags "$MAX_DATED_TAGS"
    )

    if [ -n "$NOTES_FILE" ]; then
        CMD+=(--notes-file "$NOTES_FILE")
    fi
    if [ -n "$CURRENT_ARTIFACTS_DIR" ]; then
        CMD+=(--current-artifacts-dir "$CURRENT_ARTIFACTS_DIR")
    fi
    if [ -n "$RELEASE_DATE" ]; then
        CMD+=(--release-date "$RELEASE_DATE")
    fi

    "${CMD[@]}"
    printf 'Wrote changelog markdown to %s\n' "$OUTPUT"
    printf 'Wrote changelog env to %s\n' "$ENV_OUTPUT"

gen-disk-images:
    #!/usr/bin/env bash
    set -euox pipefail

    IMAGE_REF="{{ IMAGE_REGISTRY / TARGET_IMAGE + ":" + UCORE_STREAM + NVIDIA_TAG }}"
    DIGEST_FILE="{{ TARGET_IMAGE + "-" + UCORE_STREAM + NVIDIA_TAG + "." + arch() }}.digest"
    OCI_ARCHIVE="{{ TARGET_IMAGE + "-" + UCORE_STREAM + NVIDIA_TAG + "." + arch() }}.ociarchive"
    OCI_ARCHIVE_NO_ARCH="{{ TARGET_IMAGE + "-" + UCORE_STREAM + NVIDIA_TAG }}.ociarchive"
    OUTPUT_DIR="{{ GIT_ROOT / "output" }}"
    METAL_SIZE="{{ if TARGET_IMAGE =~ "hci" { "6144" } else if NVIDIA_TAG =~ "nvidia" { "6144" } else if UCORE_STREAM =~ "lts" { "5120" } else if TARGET_IMAGE =~ "minimal" { "4096" } else { "5120" } }}"
    mkdir -p "$OUTPUT_DIR"

    if [[ ! -f "$OUTPUT_DIR/$DIGEST_FILE" ]]; then
        echo "Creating digest file: $DIGEST_FILE"
        skopeo inspect --format {{ "'{{.Digest}}'" }} \
            "docker://$IMAGE_REF" > "$OUTPUT_DIR/$DIGEST_FILE"
    fi
    if [[ ! -f "$OUTPUT_DIR/$OCI_ARCHIVE" && ! -f "$OUTPUT_DIR/$OCI_ARCHIVE_NO_ARCH" ]]; then
        echo "Creating OCI archive: $OCI_ARCHIVE"
        skopeo copy --remove-signatures \
            "docker://${IMAGE_REF%:*}@$(<$OUTPUT_DIR/$DIGEST_FILE)" "oci-archive:$OUTPUT_DIR/$OCI_ARCHIVE"
    fi

    if [[ -f "$OUTPUT_DIR/$OCI_ARCHIVE" ]]; then
        mv "$OUTPUT_DIR/$OCI_ARCHIVE" "$OUTPUT_DIR/$OCI_ARCHIVE_NO_ARCH"
    fi

    # Check if builder container is running
    if [[ "$({{ ROOTFUL_PODMAN }} container inspect -f {{ "'{{.State.Running}}'" }} builder 2>/dev/null)" == "true" ]]; then
        {{ ROOTFUL_PODMAN }} exec -w /work builder \
        sh /ucore/custom-coreos-disk-images/custom-coreos-disk-images.sh \
            --osname "fedora-coreos" \
            --platforms "qemu,metal,live" \
            --ociarchive "/ucore/output/$OCI_ARCHIVE_NO_ARCH" \
            --imgref "ostree-image-signed:docker://$IMAGE_REF" \
            --metal-image-size "$METAL_SIZE"

        {{ ROOTFUL_PODMAN }} exec -w /work builder \
            sh -c 'for f in ./*.iso ./*.raw ./*.qcow2; do if [ -e "$f" ]; then mv "$f" /ucore/output/"$f"; fi; done'

        {{ SUDO_IF }} chown -R $USER:$USER "$OUTPUT_DIR"
        echo "Disk images created for {{ TARGET_IMAGE + "-" + UCORE_STREAM + NVIDIA_TAG }}"
    else
        echo "Builder container is not running. Exiting."
        exit 1
    fi

setup-disk-image-builder:
    #!/usr/bin/env bash
    set -euox pipefail
    {{ ROOTFUL_PODMAN }} rm -f builder || true
    {{ ROOTFUL_PODMAN }} volume create --ignore ucore-builder-work
    {{ ROOTFUL_PODMAN }} volume create --ignore ucore-builder-var

    {{ ROOTFUL_PODMAN }} run \
           --detach \
           --entrypoint "tail" \
           --name builder \
           --privileged \
           --security-opt apparmor=unconfined \
           --security-opt label=disable \
           --security-opt seccomp=unconfined \
           --tmpfs /run \
           --tmpfs /tmp \
           --tty \
           --volume /dev:/dev \
           --volume "{{ GIT_ROOT }}:/ucore" \
           --volume ucore-builder-var:/var \
           --volume ucore-builder-work:/work \
           --workdir /work \
           fedora:latest \
           "-f" "/dev/null"

    # Give the container a moment to initialize
    sleep 5

    # Install Build Dependencies
    {{ ROOTFUL_PODMAN }} exec builder dnf install -y \
         dosfstools \
         erofs-utils \
         genisoimage \
         git-core \
         jq \
         just \
         osbuild \
         osbuild-ostree \
         osbuild-tools \
         podman \
         squashfs-tools \
         xfsprogs

    if [[ {{ arch() }} == "x86_64" ]]; then
        {{ ROOTFUL_PODMAN }} exec builder dnf install -y syslinux-nonlinux
    fi

    # Mark Git Repo Safe
    {{ ROOTFUL_PODMAN }} exec builder git config --global --add safe.directory /ucore

compress-disk-images:
    #!/usr/bin/env bash
    set -euox pipefail
    cd "{{ GIT_ROOT }}/output"
    for file in "{{ GIT_ROOT }}/output"/*; do
        if [[ "$(basename "$file")" =~ \.(raw|qcow2|iso)$ ]]; then
            zstd --rm -T0 -14 -v "$file" -o "$file.zst"
            sha256sum "$file.zst" > "$file.zst.sha256"
        fi
    done

attach-and-sign-disk-images:
    #!/usr/bin/env bash
    set -euox pipefail

    cd "{{ GIT_ROOT }}/output"
    IMAGE_DIGEST=$(<{{ TARGET_IMAGE + "-" + UCORE_STREAM + NVIDIA_TAG + "." + arch() }}.digest)
    for file in ./*.zst; do
        without_zst=${file%.*}
        file_type=${without_zst##*.}
        DISK_IMAGE_JSON=$(oras attach \
        --format json \
        --artifact-type application/vnd.ublue.ucore.disk.$file_type+zstd \
        --annotation filename=$(basename $file) \
        --annotation description="{{ DESCRIPTION }}" \
        {{ IMAGE_REGISTRY / TARGET_IMAGE }}@${IMAGE_DIGEST} \
        $(basename $file))

        DISK_IMAGE_DIGEST=$(echo "$DISK_IMAGE_JSON" | jq -r '.digest')

        # We can tag the disk image artifact if needed/wanted instead of using oras discover
        # oras tag {{ IMAGE_REGISTRY / TARGET_IMAGE }}@${IMAGE_DIGEST} $(basename $file)

        SHA256_JSON=$(oras attach \
        --format json \
        --artifact-type application/vnd.ublue.ucore.disk.$file_type+zstd.sha256 \
        --annotation filename=$(basename $file) \
        --annotation description="sha256 of $(basename $file)" \
        {{ IMAGE_REGISTRY / TARGET_IMAGE }}@${DISK_IMAGE_DIGEST} \
        $(basename $file).sha256)

        SHA256_DIGEST=$(echo "$SHA256_JSON" | jq -r '.digest')

        # We can tag the SHA256 artifact as well if needed/wanted instead of using oras discover
        # oras tag {{ IMAGE_REGISTRY / TARGET_IMAGE }}@${SHA256_DIGEST} $(basename $file).sha256

        cosign sign -y --key env://COSIGN_PRIVATE_KEY --new-bundle-format=false --use-signing-config=false "{{ IMAGE_REGISTRY / TARGET_IMAGE }}@${DISK_IMAGE_DIGEST}"
        cosign sign -y --key env://COSIGN_PRIVATE_KEY --new-bundle-format=false --use-signing-config=false "{{ IMAGE_REGISTRY / TARGET_IMAGE }}@${SHA256_DIGEST}"
    done

    oras discover --format json "{{ IMAGE_REGISTRY / TARGET_IMAGE }}@${IMAGE_DIGEST}"
