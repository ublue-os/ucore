# Enable Ucore Path Provisioning
enable ucore-paths-provision.service

# Enable gssproxy workarounds
enable gssproxy-workaround.service

# Disable Zincati
disable zincati.service

# Disable docker.socket
disable docker.socket

# Disable Tuned
disable tuned.service

# Automatic Updates via rpm-ostreed
enable rpm-ostreed-automatic.timer

# Disable CoreOS MOTD warnings
disable coreos-container-signing-migration-motd.service
disable coreos-oci-migration-motd.service